# Base URL of the API Gateway. The frontend never talks to an internal
# service directly — this is the one place the whole app's backend
# location is configured.
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Google reCAPTCHA v2 site key shown on the login/register forms. Real key
# pair registered at https://www.google.com/recaptcha/admin, paired with
# the secret key auth-service uses. Make sure "localhost" is in this key's
# allowed domains list when testing locally.
VITE_RECAPTCHA_SITE_KEY=6LfiK6MtAAAAABnEH2scOy7gx-Kf3ZmqNuozbr8Z
