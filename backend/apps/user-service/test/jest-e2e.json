{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@app/common(|/.*)$": "<rootDir>/../../libs/common/src/$1",
    "^@app/events(|/.*)$": "<rootDir>/../../libs/events/src/$1",
    "^@app/messaging(|/.*)$": "<rootDir>/../../libs/messaging/src/$1"
  }
}
